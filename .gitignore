.venv/

# Python cache
__pycache__/
*.pyc

# DuckDB warehouse files
*.duckdb
*.duckdb.wal

# dbt
target/
dbt_packages/
logs/

# Environment / secrets
.env
profiles.yml

# OS clutter
.DS_Store

# Editor
.vscode/

# Generated data (regenerable from scripts/generate_data.py)
data/

# dbt local state (machine-specific telemetry id)
.user.yml

# DuckDB profiles hold no credentials, only a local file path.
# Committing this one makes the repo clone-and-run.
!dbt/profiles.yml
